# ── LLM ──────────────────────────────────────────────
# Primary: Google Gemini 2.0 Flash (free: 10 RPM, 500 RPD)
GEMINI_API_KEY=your_gemini_key

# Fallback: Groq (free: 14,400 RPD text, 1,000 RPD vision)
GROQ_API_KEY=your_groq_key

# ── Plant Disease ─────────────────────────────────────
# HuggingFace Inference (free tier)
HUGGINGFACE_API_KEY=your_hf_key

# PlantNet (free: 500/day, optional)
PLANTNET_API_KEY=your_plantnet_key

# ── Auth & Database (optional for Phase 3) ────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Error Monitoring (optional) ───────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ── No key needed for ─────────────────────────────────
# Open-Meteo (weather + ag indices) — free
# SoilGrids ISRIC (soil data) — free
# GEMS Crop Calendar — free
# DAM market prices — free
# WFP/HDX — free
