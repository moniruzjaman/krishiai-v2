# ═══════════════════════════════════════════════════════════
# KrishiAI v2 — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# IMPORTANT: In Vercel, add these under Settings → Environment Variables
# API keys (GEMINI, GROQ, etc.) are server-side only — used by /api/* routes
# VITE_ prefixed keys are exposed to the browser at build time
#
# ═══════════════════════════════════════════════════════════

# ── LLM (Required for AI chat/analysis) ──────────────
# Primary: Google Gemini 2.0 Flash (free: 10 RPM, 500 RPD)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key

# Fallback: Groq (free: 14,400 RPD text, 1,000 RPD vision)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key

# ── Plant Disease Detection ──────────────────────────
# HuggingFace Inference (free tier)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hf_key

# PlantNet (free: 500/day, optional fallback)
# Get key: https://my-api.plantnet.org
PLANTNET_API_KEY=

# ── Auth & Database (Optional) ───────────────────────
# Supabase project for user authentication & profiles
# The app works without these — auth features will be disabled
# IMPORTANT: Set these in Vercel as VITE_ prefixed (exposed to browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── API Base (Optional) ──────────────────────────────
# Override if API is hosted on a different domain
# Default: empty (same origin as frontend)
VITE_API_BASE=

# ── No key needed for these free APIs ────────────────
# Open-Meteo (weather + agricultural indices) — free, no key
# SoilGrids ISRIC (soil data) — free, no key
# GEMS Crop Calendar — free, no key
# DAM market prices — free, no key
# WFP/HDX food prices — free, no key
