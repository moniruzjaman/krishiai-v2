# ─── Krishi AI v2 — Environment Variables ───────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── LLM: Google Gemini (PRIMARY) ─────────────────────────────────────────────
# Free tier: 10 RPM, 500 RPD, 1M context window, vision support
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM: Groq (FALLBACK — text + vision) ─────────────────────────────────────
# Free tier: 14,400 RPD (Llama 3.3 70B text), 1,000 RPD (Llama 4 Scout vision)
# OpenAI-compatible API. Get key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Plant Disease: HuggingFace ────────────────────────────────────────────────
# Free tier: ~30K requests/month on Inference API
# Get token: https://huggingface.co/settings/tokens (read access)
# Models used:
#   Tier 1: wambugu71/crop_leaf_diseases_vit   (rice, wheat, corn)
#   Tier 2: linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
HUGGINGFACE_API_KEY=hf_your_token_here

# ── Plant Disease: PlantNet (OPTIONAL — Tier 3) ───────────────────────────────
# Free tier: 500 identifications/day, 50K+ species, EPPO codes
# Get key: https://my.plantnet.org/account/api-access
PLANTNET_API_KEY=your_plantnet_key_here

# ── Auth & Database: Supabase (OPTIONAL — Phase 3) ───────────────────────────
# Free tier: 50K MAU, 500MB DB, realtime
# Create project: https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Error Monitoring: Sentry (OPTIONAL) ──────────────────────────────────────
# Free tier: 5,000 events/month, 90-day retention
# Create project: https://sentry.io
VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# ─── NO KEY NEEDED ───────────────────────────────────────────────────────────
# Open-Meteo (weather + soil moisture + ET0 + GDD):  api.open-meteo.com
# SoilGrids ISRIC (soil characterization):           rest.isric.org
# GEMS Crop Calendar (UMN):                          gems.umn.edu
# DAM Bangladesh (market prices, scraped):           market.dam.gov.bd
# WFP/HDX Bangladesh (market fallback):              api.hungermapdata.org
